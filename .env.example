# 複製成 .env.local（這個檔案不入倉庫）後填入你自己的值
#
# 開發區：DB_DRIVER=neon，DATABASE_URL 用 Neon 的 connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DB_DRIVER=neon

# 正式區（ECS + RDS）：DB_DRIVER=pg，DATABASE_URL 指向 RDS 的 endpoint
# DB_DRIVER=pg
# DATABASE_URL=postgresql://user:password@rds-endpoint.ap-southeast-2.rds.amazonaws.com:5432/lucaaws?sslmode=require

APP_ENV=development
AWS_REGION=ap-southeast-2

# 可選：pg 連接池與逾時
PG_POOL_MAX=5
PG_CONNECT_TIMEOUT_MS=10000
